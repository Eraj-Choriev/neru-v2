# Copy to .env and fill in, then run: node scripts/build-config.mjs
# On Vercel set the same names in Project Settings → Environment Variables
# (Production AND Preview). .env is git-ignored and must never be committed.

# 2GIS MapGL browser key — https://platform.2gis.ru (Platform Manager).
# Required. Restrict it to your domains with the Referer allow-list there.
NUR_2GIS_KEY=

# Cloudflare Web Analytics beacon token. Optional: empty disables analytics.
NUR_CF_BEACON_TOKEN=
